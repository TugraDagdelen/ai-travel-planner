APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FREE_ONLY_MODE=true
ENABLE_GOOGLE_MAPS_GROUNDING=false
ENABLE_GOOGLE_SEARCH_GROUNDING=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after checking the key's project uses Free tier without billing,
# is region-eligible, and the model is available. This is your attestation,
# not an automatic verification of Google's billing settings. See docs/gemini-setup.md.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_TIMEOUT_SECONDS=25
GEMINI_DAILY_LIMIT=10
GEMINI_MINUTE_LIMIT=6
MAX_TRIP_DAYS=14
PROVIDER_TIMEOUT_SECONDS=25
PROVIDER_HOURLY_LIMIT=120
PROVIDER_DAILY_LIMIT=600
METEO_MIN_INTERVAL_SECONDS=1
OVERPASS_MIN_INTERVAL_SECONDS=3
DATABASE_URL=sqlite:///./data/travel_planner.db
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=75
